<!DOCTYPE html>
<html lang="{{ lang | default('vi') }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="{{ description | default('Open Vietnamese — Tiếng Việt Mở, Tiếng Việt Cho Mọi Người') }}" />
  <title>{{ pageTitle }} — Open Vietnamese</title>
  <meta name="theme-color" content="#1B2559" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta property="og:title" content="{{ pageTitle }} — Open Vietnamese" />
  <meta property="og:description" content="{{ description | default('Open Vietnamese — Tiếng Việt Mở, Tiếng Việt Cho Mọi Người') }}" />
  <meta property="og:image" content="https://openvietnamese.org/assets/brand/ov-share-image-1200x630.png" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;700&family=Noto+Serif:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />

  <!-- Global styles -->
  <link rel="stylesheet" href="/assets/css/global.css" />
  <!-- Open Vietnamese brand (brand kit v1.0) — OV's own pages only -->
  <link rel="stylesheet" href="/assets/css/ov-brand.css" />

  <!-- Section styles (optional, set in front matter) -->
  {% if sectionCss %}
    <link rel="stylesheet" href="/assets/css/{{ sectionCss }}" />
  {% endif %}

  <!-- Alpine.js — shared foundation for interactive widgets (language
       switcher here; VietEI, placement exam, and vocab tools should
       build on this too, rather than hand-rolling DOM code per page). -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body>

  <a class="skip-link" href="#main">Skip to content</a>

  <!-- ── Header ─────────────────────────────────────────────── -->
  <header class="site-header">
    <!-- Hamburger (mobile only) -->
    <button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <!-- Logo -->
    <a href="/" class="site-logo">
      <img class="logo-mark" src="/assets/brand/ov-mark-solid-white.svg" alt="" width="35" height="28" />
      <span class="logo-words"><span class="logo-ov">Open Vietnamese</span><span class="logo-vi" lang="vi">Tiếng Việt Mở</span></span>
      {% if section %}
        <span class="logo-sep">·</span>
        <span class="logo-section">{{ section }}</span>
      {% endif %}
    </a>

    <!-- Desktop nav -->
    <nav class="site-nav" aria-label="Main navigation">
      <a href="/" class="nav-link active">Home</a>
    </nav>
  </header>

  {% if marketing %}

  <!-- ── Marketing page (no sidebar) ───────────────────────────── -->
  <div class="marketing-shell">
    <main id="main">
      {{ content | safe }}
    </main>
  </div>

  <!-- ── Footer ──────────────────────────────────────────────── -->
  <footer class="site-footer footer-marketing">
    <div class="footer-brand">
      <img class="logo-mark" src="/assets/brand/ov-mark-solid-white.svg" alt="" width="38" height="30" />
      <span class="logo-words"><span class="logo-ov">Open Vietnamese</span><span class="logo-vi footer-est">Est. 2024</span></span>
    </div>
  </footer>

  {% else %}

  <!-- Reading progress bar -->
  <div class="progress-bar-wrap" aria-hidden="true">
    <div class="progress-bar-fill"></div>
  </div>

  <!-- Sidebar overlay (mobile) -->
  <div class="sidebar-overlay" aria-hidden="true"></div>

  <!-- ── Page shell ──────────────────────────────────────────── -->
  <div class="page-shell">

    <!-- Sidebar -->
    <aside class="sidebar" aria-label="Section navigation">
      {% block sidebar %}
        <!-- Default: section list -->
        <div class="sidebar-module-title">Sections</div>
        <ul class="sidebar-tasks">
          <li><a href="/uncviet/">🎓 UNC Viet</a></li>
        </ul>
      {% endblock %}
    </aside>

    <!-- Main -->
    <main class="main-content" id="main">
      {{ content | safe }}
    </main>

  </div>

  <!-- ── Footer ──────────────────────────────────────────────── -->
  <footer class="site-footer">
    <span>Open Vietnamese</span>
    <span>·</span>
    <span>CC BY-NC-SA 4.0</span>
    <span>·</span>
    <a href="https://doi.org/10.17605/OSF.IO/JHQ6N" target="_blank">OSF.IO/JHQ6N</a>
    <span>·</span>
    <a href="https://openvietnamese.org">openvietnamese.org</a>
  </footer>

  <script src="/assets/js/progress.js"></script>
  <script src="/assets/js/exercises.js"></script>

  {% endif %}

  {% block scripts %}{% endblock %}

</body>
</html>
