{#- UC San Diego hub <head> block — shared by every page under src/ucsd/.
    Put it right after the viewport meta, before the page's own <style>, so the page can still override.
    Use in a page:  {% include "ucsd/head.njk" %}  then  {% include "ucsd/bar.njk" %}  and  {% include "ucsd/footer.njk" %}
    Fonts: one weight range (400–900) so every weight a page asks for is real, with the Vietnamese subset. -#}
<meta name="author" content="Content: Hoan Nguyen · Design: HUY · Supported by the Open Vietnamese Initiative">
{%- if titleEn %}
<meta name="description" content="{{ titleEn }} — {{ ucsd.byCode[course].name }}, Heritage Vietnamese Program, UC San Diego.">
{%- endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,400..900;1,400..700&family=Roboto+Slab:wght@600..700&display=swap" rel="stylesheet">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 28 28'%3E%3Crect width='28' height='28' rx='6' fill='%23182B49'/%3E%3Ccircle cx='14' cy='15.5' r='8' fill='none' stroke='%23fff' stroke-width='2.4'/%3E%3Cpath d='M9 6.5h10' stroke='%23C69214' stroke-width='2.6' stroke-linecap='round'/%3E%3C/svg%3E">
<script>
/* Inside an iframe (e.g. a Canvas page) hide the top bar — Canvas already shows the course. The footer credit stays. */
try { if (window.self !== window.top) document.documentElement.classList.add('ucsd-embedded'); }
catch (e) { document.documentElement.classList.add('ucsd-embedded'); }
</script>
<style>
:root{--ucsd-navy:#182B49;--ucsd-blue:#00629B;--ucsd-gold:#C69214;--ucsd-yellow:#FFCD00}
.ucsd-bar{background:var(--ucsd-navy);display:flex;align-items:center;flex-wrap:wrap;padding:8px 18px;font-family:'Roboto','Helvetica Neue',Arial,sans-serif}
.ucsd-bar *{font-family:inherit}
.ucsd-wordmark{display:flex;align-items:center;text-decoration:none;line-height:1}
.ucsd-uc{color:var(--ucsd-gold);font-weight:900;font-size:14px;letter-spacing:-.3px}
.ucsd-name{color:#fff;font-weight:400;font-size:14px;letter-spacing:.15px}
.ucsd-pipe{width:1px;height:16px;background:rgba(255,255,255,.3);margin:0 12px;flex-shrink:0}
.ucsd-course{color:rgba(255,255,255,.78);font-size:12px;font-weight:500;letter-spacing:.3px}
.ucsd-gold-rule{height:3px;background:var(--ucsd-gold)}
.ucsd-noscript{margin:16px;padding:12px 16px;border-left:4px solid var(--ucsd-gold);background:#FFF8E1;color:var(--ucsd-navy);font:15px/1.5 'Roboto',Arial,sans-serif}
.ucsd-embedded .ucsd-bar,.ucsd-embedded .ucsd-gold-rule{display:none}
@media print{.ucsd-bar,.ucsd-gold-rule{display:none!important}}
</style>
