{#- Study-guide engine · styles. Shared by the UCSD midterm study guides (page data lives in window.SG; see sg-engine.njk). -#}
<style>
    :root { --ls-ch: #00629B; }
    * { box-sizing: border-box; }
    body { font-family: 'Roboto', 'Helvetica Neue', Arial, sans-serif; color: #1F2A37; margin: 0; display: flex; flex-direction: column; min-height: 100vh; line-height: 1.55; }
    .en { color: #5B6770; }
    .hint { font-size: 13px; color: #5B6770; margin: 0 0 12px; }
    h3 { font: 700 16px 'Roboto Slab', Georgia, serif; color: #182B49; margin: 18px 0 8px; }
    h3:first-child { margin-top: 0; }

    .btn { appearance: none; border: 1.5px solid #D5E0E8; background: #fff; color: #182B49; border-radius: 10px; padding: 8px 16px; font: 700 14px 'Roboto', Arial, sans-serif; cursor: pointer; }
    .btn:hover { background: #E6EFF5; border-color: #00629B; }
    .btn.primary { background: #00629B; border-color: #00629B; color: #fff; }
    .btn.primary:hover { background: #182B49; }
    .btn.good { background: #15803D; border-color: #15803D; color: #fff; }
    .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .chip { appearance: none; border: 1px solid #D5E0E8; background: #fff; color: #182B49; border-radius: 99px; padding: 5px 13px; font: 600 13px 'Roboto', Arial, sans-serif; cursor: pointer; }
    .chip[aria-pressed="true"] { background: #182B49; border-color: #182B49; color: #fff; }
    .say { appearance: none; border: 0; background: #E6EFF5; color: #182B49; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; font-size: 15px; flex: none; }
    .say:hover { background: #CCE0EB; }

    /* overview */
    .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin: 0 0 16px; }
    .fact { background: #F2F6F9; border: 1px solid #D5E0E8; border-radius: 12px; padding: 12px 14px; }
    .fact b { display: block; font: 700 22px 'Roboto Slab', Georgia, serif; color: #00629B; }
    table.t { width: 100%; border-collapse: collapse; font-size: 14.5px; }
    table.t th, table.t td { padding: 9px 10px; border-bottom: 1px solid #D5E0E8; text-align: left; vertical-align: top; }
    table.t th { background: #E6EFF5; color: #182B49; font-weight: 700; }
    .scroll { overflow-x: auto; }

    /* vocabulary */
    .vrow td:first-child { font-weight: 700; color: #182B49; }
    .vrow .vi-cell { display: flex; align-items: center; gap: 8px; }
    .cloak .vrow .meaning { color: transparent; background: #E6EFF5; border-radius: 6px; cursor: pointer; user-select: none; }
    .cloak .vrow .meaning.shown { color: #1F2A37; background: none; }

    /* flashcards (viet101-hw style: navy front, white back with a gold edge) */
    .deck { text-align: center; }
    .row.center { justify-content: center; }
    .deck-info { font: 600 12.5px 'Roboto', Arial, sans-serif; color: #5B6770; margin-bottom: 12px; }
    .flashcard { width: 100%; max-width: 520px; min-height: 250px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 26px 28px; border-radius: 18px; cursor: pointer; background: #182B49; color: #fff; border: 2px solid #182B49; box-shadow: 0 8px 24px rgba(24,43,73,.18); transition: background .2s, border-color .2s; user-select: none; }
    .flashcard:focus-visible { outline: 3px solid #C69214; outline-offset: 3px; }
    .flashcard.flipped { background: #fff; color: #1F2A37; border-color: #C69214; }
    .fc-vi { font: 700 36px/1.2 'Roboto Slab', Georgia, serif; }
    .flashcard.flipped .fc-vi { font-size: 28px; color: #00629B; }
    .fc-en { font: 600 20px/1.35 'Roboto', Arial, sans-serif; }
    .fc-ex { font-size: 17px; font-style: italic; margin-top: 8px; color: #182B49; }
    .fc-ex-en { font-size: 14.5px; color: #5B6770; }
    .fc-ex-say { appearance: none; border: 0; background: #E6EFF5; color: #182B49; border-radius: 99px; padding: 3px 11px; font: 700 12px 'Roboto', Arial, sans-serif; cursor: pointer; margin-top: 4px; }
    .fc-ex-say:hover { background: #CCE0EB; }
    .fc-hint { font: 500 12px 'Roboto', Arial, sans-serif; opacity: .65; margin-top: 12px; }
    .fc-done { font: 700 22px 'Roboto Slab', Georgia, serif; }
    .know-btn { appearance: none; border-radius: 12px; padding: 11px 22px; font: 700 15px 'Roboto', Arial, sans-serif; cursor: pointer; border: 2px solid; }
    .know-btn:disabled { opacity: .4; cursor: not-allowed; }
    .know-btn.yes { background: #15803D; border-color: #15803D; color: #fff; }
    .know-btn.no { background: #FFF4D6; border-color: #C69214; color: #8A6400; }
    /* reading tooltips */
    .tip { border-bottom: 2px dotted #C69214; cursor: help; }
    .tip:focus-visible, .tip.on { outline: 2px solid #00629B; outline-offset: 1px; background: #FFF4D6; }
    #tipbox { position: absolute; z-index: 300; display: none; max-width: 260px; background: #182B49; color: #fff; border-radius: 8px; padding: 7px 11px; font: 600 14px/1.35 'Roboto', Arial, sans-serif; box-shadow: 0 6px 18px rgba(24,43,73,.25); pointer-events: none; }
    /* matching */
    .mt { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 14px; }
    .mt-col { display: flex; flex-direction: column; gap: 10px; }
    .tile { appearance: none; background: #fff; border: 2px solid #D5E0E8; border-radius: 12px; padding: 12px; min-height: 56px; font: 600 14.5px 'Roboto', Arial, sans-serif; color: #1F2A37; cursor: pointer; text-align: center; }
    .tile:hover { border-color: #00629B; }
    .tile.sel { background: #E6EFF5; border-color: #00629B; }
    .tile.done { background: #DCFCE7; border-color: #22C55E; color: #15803D; cursor: default; }
    .tile.bad { background: #FEE2E2; border-color: #EF4444; color: #B91C1C; }
    .score { font-weight: 700; color: #182B49; margin: 0 0 12px; }

    /* grammar */
    .g-card { border: 1px solid #D5E0E8; border-left: 5px solid #C69214; border-radius: 10px; padding: 12px 16px; margin: 0 0 14px; background: #fff; }
    .g-card h3 { margin-top: 0; }
    .ex { display: flex; align-items: flex-start; gap: 8px; margin: 6px 0; }
    .ex .vi { font-weight: 600; color: #182B49; }
    .ex .en { font-size: 13.5px; }
    .pill { display: inline-block; background: #FFF4D6; color: #8A6400; border-radius: 99px; padding: 1px 10px; font-weight: 700; font-size: 13px; }
    .pill.no { background: #FEE2E2; color: #B91C1C; }
    .pill.yes { background: #DCFCE7; color: #15803D; }
    .meter3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .meter3 > div { background: #F2F6F9; border: 1px solid #D5E0E8; border-radius: 10px; padding: 10px 12px; }
    .meter3 b { font: 700 20px 'Roboto Slab', Georgia, serif; color: #00629B; }
    @media (max-width: 600px) { .meter3 { grid-template-columns: 1fr; } }

    /* multiple choice */
    .q { border: 1px solid #D5E0E8; border-radius: 12px; padding: 14px 16px; margin: 0 0 14px; background: #fff; }
    .q-text { font-weight: 600; margin: 0 0 10px; display: flex; gap: 8px; align-items: flex-start; }
    .q-text .n { color: #C69214; font-weight: 800; }
    .opts { display: grid; gap: 8px; }
    .opt { appearance: none; text-align: left; background: #fff; border: 1.5px solid #DDE3E8; border-radius: 10px; padding: 10px 14px; font: 500 14.5px 'Roboto', Arial, sans-serif; color: #1F2A37; cursor: pointer; }
    .opt:hover:not(:disabled) { border-color: #00629B; background: #F2F6F9; }
    .opt.right { background: #DCFCE7; border-color: #22C55E; color: #15803D; font-weight: 700; }
    .opt.wrong { background: #FEE2E2; border-color: #EF4444; color: #B91C1C; }
    .why { display: none; margin-top: 10px; padding: 10px 12px; border-left: 4px solid #C69214; background: #F5F7FA; border-radius: 6px; font-size: 14px; }
    .why.on { display: block; }

    /* arrange */
    .arr { border: 1px solid #D5E0E8; border-radius: 12px; padding: 14px 16px; margin: 0 0 14px; background: #fff; }
    .slot { min-height: 52px; border: 2px dashed #9AA9B5; border-radius: 10px; padding: 8px; display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0; align-items: center; background: #FBFCFD; }
    .slot.ok { border-style: solid; border-color: #22C55E; background: #F0FDF4; }
    .slot.no { border-style: solid; border-color: #EF4444; background: #FEE2E2; }
    .tok { appearance: none; background: #fff; border: 1.5px solid #00629B; color: #182B49; border-radius: 8px; padding: 6px 12px; font: 700 15px 'Roboto', Arial, sans-serif; cursor: pointer; }
    .tok:hover { background: #E6EFF5; }
    .tok.used { visibility: hidden; }
    .fb { font-size: 14px; margin-top: 8px; min-height: 20px; }
    .fb.ok { color: #15803D; font-weight: 700; }
    .fb.no { color: #B91C1C; font-weight: 700; }

    /* reading */
    .passage { background: #F5F7FA; border: 1px solid #D5E0E8; border-left: 5px solid #00629B; border-radius: 10px; padding: 14px 18px; margin: 0 0 16px; font-size: 16px; line-height: 1.7; }
    .passage h3 { margin: 0 0 8px; }
    .passage p { margin: 0 0 8px; }
    .gloss { font-size: 13px; color: #5B6770; }

    /* writing */
    .check { display: flex; gap: 8px; align-items: flex-start; margin: 6px 0; font-size: 14.5px; cursor: pointer; }
    .check input { margin-top: 4px; accent-color: #00629B; }
    textarea.write { width: 100%; min-height: 190px; border: 1.5px solid #D5E0E8; border-radius: 10px; padding: 12px; font: 16px/1.6 'Roboto', Arial, sans-serif; color: #1F2A37; resize: vertical; }
    textarea.write:focus { outline: 2px solid #00629B; border-color: #00629B; }
    .model { display: none; background: #FFF8E1; border-left: 4px solid #C69214; border-radius: 6px; padding: 12px 16px; margin-top: 12px; }
    .model.on { display: block; }
    .model p { margin: 0 0 6px; }
    .frames { margin: 0; padding-left: 20px; }
    .frames li { margin: 3px 0; }

    /* report */
    .rp-head { display: flex; gap: 12px; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; margin-bottom: 4px; }
    .rp-ch { font: 700 17px 'Roboto Slab', Georgia, serif; color: #182B49; }
    .rp-date { font-size: 13px; color: #5B6770; }
    .rp-name { border: 1.5px solid #D5E0E8; border-radius: 10px; padding: 9px 12px; font: 16px 'Roboto', Arial, sans-serif; min-width: 240px; max-width: 100%; }
    .rp-name:focus { outline: 2px solid #00629B; border-color: #00629B; }
    .rp-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin: 14px 0 4px; }
    .rp-stat { background: #F2F6F9; border-radius: 10px; padding: 12px; }
    .rp-stat span { display: block; font: 700 11px 'Roboto', Arial, sans-serif; letter-spacing: .06em; text-transform: uppercase; color: #5B6770; }
    .rp-stat b { display: block; font: 700 21px 'Roboto Slab', Georgia, serif; color: #182B49; margin-top: 2px; }
    .rp-code { background: #E6EFF5; border-left: 4px solid #00629B; border-radius: 6px; padding: 10px 14px; margin: 12px 0; }
    .rp-text { white-space: pre-wrap; background: #F2F6F9; border-radius: 8px; padding: 12px; line-height: 1.6; }
    .rp-warn { color: #B91C1C; font-weight: 700; }
    @media (max-width: 600px) { .mt { gap: 8px; } .fc-word { font-size: 28px; } }
</style>

