{#- Study-guide engine v1 (Essentials, frozen 2026-10-31) · tab bar (11 tabs).
    Optional front matter  sgTabs: { grammar: "label", practice: "label", practiceHead: "card title", noArrange: true }  (added for LIHL 134). -#}
<nav class="ls-tabs" aria-label="Hoạt động · Activities"><div class="ls-tabs-in">
  <button type="button" class="tab-btn ls-tab active" data-tab="start">🎯 Bắt đầu</button>
  <button type="button" class="tab-btn ls-tab" data-tab="words">📖 Từ vựng</button>
  <button type="button" class="tab-btn ls-tab" data-tab="cards">🗂️ Thẻ từ</button>
  <button type="button" class="tab-btn ls-tab" data-tab="match">🧩 Nối từ</button>
  <button type="button" class="tab-btn ls-tab" data-tab="listen">🎧 Nghe</button>
  <button type="button" class="tab-btn ls-tab" data-tab="grammar">{{ (sgTabs and sgTabs.grammar) or "📐 Ngữ pháp" }}</button>
  <button type="button" class="tab-btn ls-tab" data-tab="practice">{{ (sgTabs and sgTabs.practice) or "✍️ Luyện ngữ pháp" }}</button>
  {%- if not (sgTabs and sgTabs.noArrange) %}
  <button type="button" class="tab-btn ls-tab" data-tab="arrange">🔀 Sắp xếp từ</button>
  {%- endif %}
  <button type="button" class="tab-btn ls-tab" data-tab="reading">📰 Đọc hiểu</button>
  <button type="button" class="tab-btn ls-tab" data-tab="writing">📝 Viết</button>
  <button type="button" class="tab-btn ls-tab" data-tab="report">📋 Báo cáo</button>
</div></nav>
