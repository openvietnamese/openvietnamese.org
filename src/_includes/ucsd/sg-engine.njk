{#- Study-guide engine · behaviour. Reads window.SG (set by the page just before this include):
    { course, code, cats, words, ex, practice (with g = grammar card number), challenge, arrange, reads (with q, sa, gloss),
      topics, writing { head, instr, targets }, cando, mockMinutes }.
    Spoken texts must stay in step with _tools/ucsd/make-recording-list.js (mode  recordFrom: SG):
    words, data-say="…" in the page, word-order answers, readings, model essays / letters. -#}
<script>
(function () {
  /* ───────── content: everything page-specific comes from window.SG (see the page) ───────── */
  var SG = window.SG, CATS = SG.cats, PRACTICE = SG.practice, ARRANGE = SG.arrange, TOPICS = SG.topics, READS = SG.reads, EX = SG.ex || {};
  var CHALLENGE = SG.challenge || [], CANDO = SG.cando || [], TARGETS = (SG.writing && SG.writing.targets) || [];
  var W = SG.words.map(function (r) { return { cat: r[0], vi: r[1], en: r[2], ex: (EX[r[1]] || [])[0], exEn: (EX[r[1]] || [])[1], say: r[3] || r[1] }; });
  var READ_TEXT = {}; READS.forEach(function (r) { READ_TEXT[r.id] = r.say; });

  var $ = function (id) { return document.getElementById(id); };

  /* ───────── learner state (kept in this browser only) ───────── */
  var SKEY = "ucsd" + SG.code + "-midterm-state", WKEY = "ucsd" + SG.code + "-midterm-writing-";
  var ST = (function () { try { return JSON.parse(localStorage.getItem(SKEY)) || {}; } catch (e) { return {}; } })();
  ST.best = ST.best || {}; ST.known = ST.known || []; ST.knownAt = ST.knownAt || {}; ST.active = ST.active || 0; ST.start = ST.start || Date.now();
  ST.name = ST.name || ""; ST.matchSets = ST.matchSets || 0; ST.seen = ST.seen || {}; ST.missQ = ST.missQ || []; ST.missW = ST.missW || [];
  ST.sa = ST.sa || {}; ST.cando = ST.cando || { before: [], after: [] }; ST.rubric = ST.rubric || {};
  ST.known.forEach(function (v) { if (!ST.knownAt[v]) ST.knownAt[v] = Date.now(); });
  var onSave = [];
  function saveST() { try { localStorage.setItem(SKEY, JSON.stringify(ST)); } catch (e) {} onSave.forEach(function (f) { f(); }); }
  function best(id, got, total) {   // keep the best ratio (rounds can differ in length); on a tie, the longer round
    var b = ST.best[id], r = total ? got / total : 0, rb = b && b.total ? b.got / b.total : -1;
    if (!b || r > rb || (r === rb && total > b.total)) { ST.best[id] = { got: got, total: total }; saveST(); }
  }
  function addTo(list, v) { if (ST[list].indexOf(v) < 0) { ST[list].push(v); saveST(); } }
  function dropFrom(list, v) { var i = ST[list].indexOf(v); if (i > -1) { ST[list].splice(i, 1); saveST(); } }
  /* time on task: counts only while the page is visible and used within the last 2 minutes */
  var lastAct = Date.now();
  ["pointerdown", "keydown", "input", "scroll"].forEach(function (ev) { document.addEventListener(ev, function () { lastAct = Date.now(); }, true); });
  setInterval(function () { if (!document.hidden && Date.now() - lastAct < 120000) { ST.active += 5; saveST(); } }, 5000);

  /* ───────── helpers ───────── */
  var esc = function (s) { return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); };
  function shuffle(a) { a = a.slice(); for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = a[i]; a[i] = a[j]; a[j] = t; } return a; }
  function say(text, slow) {
    if (!("speechSynthesis" in window)) return;
    speechSynthesis.cancel();
    var u = new SpeechSynthesisUtterance(String(text).replace(/\//g, ", "));
    u.lang = "vi-VN"; u.rate = slow ? 0.6 : 0.85; speechSynthesis.speak(u);
  }
  var isLetter = function (ch) { return !!ch && /[\p{L}\p{M}]/u.test(ch); };
  var nWords = function (t) { return (String(t || "").trim().match(/\S+/g) || []).length; };
  function catChips(box, withAll, onPick) {
    var cur = withAll ? "all" : CATS[0].id, items = (withAll ? [{ id: "all", label: "Tất cả · All" }] : []).concat(CATS);
    box.innerHTML = items.map(function (c) { return '<button type="button" class="chip" data-c="' + c.id + '" aria-pressed="' + (c.id === cur) + '">' + c.label + "</button>"; }).join("");
    box.addEventListener("click", function (e) {
      var b = e.target.closest(".chip"); if (!b) return;
      cur = b.dataset.c;
      [].forEach.call(box.children, function (x) { x.setAttribute("aria-pressed", x === b); });
      onPick(cur);
    });
    return function () { return cur; };
  }
  var inCat = function (c) { return W.filter(function (w) { return c === "all" || w.cat === c; }); };
  var byVi = {}; W.forEach(function (w) { byVi[w.vi] = w; });

  /* Answer checking. Both spellings count as the same (kỹ / kĩ, lý / lí, hòa / hoà, thủy / thuỷ); case and punctuation are ignored.
     "near" = right letters, wrong or missing tone marks / vowel marks. */
  var TONE_FIX = [["oà", "òa"], ["oá", "óa"], ["oả", "ỏa"], ["oã", "õa"], ["oạ", "ọa"], ["oè", "òe"], ["oé", "óe"], ["oẻ", "ỏe"], ["oẽ", "õe"], ["oẹ", "ọe"],
                  ["uỳ", "ùy"], ["uý", "úy"], ["uỷ", "ủy"], ["uỹ", "ũy"], ["uỵ", "ụy"]].map(function (p) { return [new RegExp(p[0] + "(?= |$)", "g"), p[1]]; });
  var Y2I = { "y": "i", "ý": "í", "ỳ": "ì", "ỷ": "ỉ", "ỹ": "ĩ", "ỵ": "ị" };
  function canon(s) {
    s = String(s || "").normalize("NFC").toLowerCase().replace(/[“”"'‘’.,!?;:…()\-–—]/g, " ").replace(/\s+/g, " ").trim();
    TONE_FIX.forEach(function (p) { s = s.replace(p[0], p[1]); });
    return s.replace(/(^| )([klmts])([yýỳỷỹỵ])(?= |$)/g, function (m, a, c, y) { return a + c + Y2I[y]; });
  }
  var bare = function (s) { return canon(s).normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/đ/g, "d"); };
  function judge(input, answers) {
    var c = canon(input); if (!c) return "empty";
    if (answers.some(function (a) { return canon(a) === c; })) return "ok";
    if (answers.some(function (a) { return bare(a) === bare(input); })) return "near";
    return "no";
  }
  function variants(w) {
    var out = [w.vi].concat(w.vi.split("/"), w.say.split(/,\s*/));
    return out.map(function (x) { return x.trim(); }).filter(function (x, i, a) { return x && a.indexOf(x) === i; });
  }
  function findIn(text, v) {   // index of v in text as a whole word / phrase, or -1
    var low = text.toLowerCase(), t = v.toLowerCase(), i = low.indexOf(t);
    while (i > -1) { if (!isLetter(text.charAt(i - 1)) && !isLetter(text.charAt(i + t.length))) return i; i = low.indexOf(t, i + 1); }
    return -1;
  }
  function blankOf(w) {   // the word's example sentence with the word blanked out, or null
    if (!w.ex) return null;
    var vs = variants(w).filter(function (v) { return v.indexOf("/") < 0; }).sort(function (a, b) { return b.length - a.length; });
    for (var k = 0; k < vs.length; k++) {
      var i = findIn(w.ex, vs[k]);
      if (i > -1) return { w: w, pre: w.ex.slice(0, i), post: w.ex.slice(i + vs[k].length), ans: w.ex.substr(i, vs[k].length) };
    }
    return null;
  }
  var FB = {
    ok: function (a) { return "✅ Đúng rồi! · Correct" + (a ? ": <strong>" + esc(a) + "</strong>" : ""); },
    near: function (a) { return "🟡 Gần đúng: kiểm tra dấu. · Almost: check the tone and vowel marks. Đáp án · Answer: <strong>" + esc(a) + "</strong>"; },
    no: function (a) { return "❌ Chưa đúng. · Not yet. Đáp án · Answer: <strong>" + esc(a) + "</strong>"; },
    empty: function () { return "✍️ Hãy gõ câu trả lời trước. · Type an answer first."; }
  };

  /* accent keypad for any typing card: inserts into the last field the learner used in that card */
  var MARKS = [["\u0301", "sắc"], ["\u0300", "huyền"], ["\u0309", "hỏi"], ["\u0303", "ngã"], ["\u0323", "nặng"]];
  function palette(scope) {
    var last = null;
    scope.addEventListener("focusin", function (e) { var t = e.target; if (t.tagName === "TEXTAREA" || (t.tagName === "INPUT" && t.type === "text")) last = t; });
    var el = document.createElement("div"); el.className = "pal";
    el.innerHTML = '<span class="pal-l">Bàn phím dấu · Accent keys</span>' +
      ["ă", "â", "đ", "ê", "ô", "ơ", "ư"].map(function (l) { return '<button type="button" class="pk" data-ch="' + l + '">' + l + "</button>"; }).join("") +
      MARKS.map(function (m) { return '<button type="button" class="pk tone" data-mk="' + m[0] + '" title="' + m[1] + '" aria-label="dấu ' + m[1] + '">a' + m[0] + "</button>"; }).join("") +
      '<details class="howto"><summary>Cách gõ tiếng Việt · How to type Vietnamese</summary>' +
      "<p>Tone keys: put the cursor right after the vowel that takes the mark, then tap a tone. Better: turn on a Vietnamese keyboard.</p>" +
      "<p><strong>Mac:</strong> System Settings → Keyboard → Input Sources → + → Vietnamese → <em>Telex</em>. <strong>Windows:</strong> Settings → Time &amp; language → Language → add Vietnamese → keyboard <em>Vietnamese Telex</em>. <strong>Phone:</strong> add the Vietnamese keyboard in Settings.</p>" +
      '<div class="scroll"><table class="t"><tr><th>Telex</th><th>→</th><th>Telex</th><th>→</th></tr>' +
      "<tr><td>aw · aa · dd</td><td>ă · â · đ</td><td>s · f · r</td><td>sắc · huyền · hỏi (á à ả)</td></tr>" +
      "<tr><td>ee · oo · ow · uw</td><td>ê · ô · ơ · ư</td><td>x · j</td><td>ngã · nặng (ã ạ)</td></tr></table></div></details>";
    el.addEventListener("mousedown", function (e) { if (e.target.closest(".pk")) e.preventDefault(); });   // keep the cursor in the field
    el.addEventListener("click", function (e) {
      var b = e.target.closest(".pk"); if (!b || !last) return;
      var v = last.value, s = last.selectionStart == null ? v.length : last.selectionStart, en = last.selectionEnd == null ? s : last.selectionEnd;
      var before = v.slice(0, s), after = v.slice(en);
      if (b.dataset.mk) {
        var ch = before.slice(-1); if (!ch || !isLetter(ch)) return;
        var base = ch.normalize("NFD").replace(/[\u0300\u0301\u0303\u0309\u0323]/g, "");
        before = before.slice(0, -1) + (base + b.dataset.mk).normalize("NFC");
      } else before += b.dataset.ch;
      last.value = before + after; last.focus();
      if (last.setSelectionRange) last.setSelectionRange(before.length, before.length);
      last.dispatchEvent(new Event("input", { bubbles: true }));
    });
    return el;
  }

  /* generic multiple-choice block. opts: id (best score), track (remember mistakes), onAnswer(item, ok). it.a may be an array (several right answers). */
  function mcBlock(box, items, scoreEl, opts) {
    opts = opts || {};
    var right = 0;
    function head() { if (scoreEl) scoreEl.textContent = right + " / " + items.length + " đúng · correct"; }
    box.innerHTML = "";
    items.forEach(function (it, i) {
      var q = document.createElement("div"); q.className = "q";
      q.innerHTML = '<p class="q-text"><span class="n">' + (i + 1) + '.</span><span>' + esc(it.q) + '</span></p><div class="opts"></div><div class="why"></div>';
      var ob = q.querySelector(".opts"), why = q.querySelector(".why"), answered = false, good = [].concat(it.a);
      it.o.forEach(function (txt, k) {
        var b = document.createElement("button"); b.type = "button"; b.className = "opt"; b.textContent = String.fromCharCode(65 + k) + ". " + txt;
        b.onclick = function () {
          if (answered) return; answered = true;
          var ok = good.indexOf(k) > -1; if (ok) right++;
          b.classList.add(ok ? "right" : "wrong");
          if (!ok) good.forEach(function (g) { ob.children[g].classList.add("right"); });
          [].forEach.call(ob.children, function (x) { x.disabled = true; });
          why.innerHTML = (ok ? "✅ " : "❌ ") + esc(it.why || ""); why.classList.add("on"); head();
          if (opts.id) best(opts.id, right, items.length);
          if (opts.track) { if (ok) dropFrom("missQ", it.q); else addTo("missQ", it.q); }
          if (opts.onAnswer) opts.onAnswer(it, ok);
        };
        ob.appendChild(b);
      });
      box.appendChild(q);
    });
    head();
  }

  /* one typed word item (spelling, review): English prompt + 🔊, type the Vietnamese */
  function spellItem(box, w, done) {
    var el = document.createElement("div"); el.className = "q sp";
    el.innerHTML = '<p class="q-text"><button type="button" class="say" data-say="' + esc(w.say) + '" aria-label="Nghe">🔊</button><span class="sp-en">' + esc(w.en) + "</span></p>" +
      '<div class="row"><input type="text" class="ans" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Viết bằng tiếng Việt · Type it in Vietnamese" placeholder="Viết bằng tiếng Việt…"><button type="button" class="btn primary chk">Kiểm tra · Check</button></div><div class="fb"></div>';
    var inp = el.querySelector(".ans"), fb = el.querySelector(".fb"), finished = false;
    function check() {
      if (finished) { if (done) done(null); return; }
      var r = judge(inp.value, variants(w));
      fb.innerHTML = FB[r](w.vi); fb.className = "fb " + (r === "ok" ? "ok" : r === "empty" ? "" : "no");
      if (r === "empty") return;
      finished = true; inp.readOnly = true; inp.classList.add(r);
      if (r === "ok") dropFrom("missW", w.vi); else addTo("missW", w.vi);
      say(w.say);
      if (done) done(r);
    }
    el.querySelector(".chk").onclick = check;
    inp.addEventListener("keydown", function (e) { if (e.key === "Enter") { e.preventDefault(); check(); } });
    box.appendChild(el);
    return inp;
  }

  /* ───────── tabs, phases and ✓ marks ───────── */
  var tabs = [].slice.call(document.querySelectorAll(".ls-tab"));
  var tabLabel = {}; tabs.forEach(function (t) { tabLabel[t.dataset.tab] = t.textContent.trim(); });
  function switchTab(id) {
    tabs.forEach(function (t) { t.classList.toggle("active", t.dataset.tab === id); });
    [].forEach.call(document.querySelectorAll(".tab-content"), function (s) { s.classList.toggle("active", s.id === "tab-" + id); });
    if (!ST.seen[id]) { ST.seen[id] = 1; saveST(); }
  }
  tabs.forEach(function (t) { t.addEventListener("click", function () { switchTab(t.dataset.tab); }); });
  var pct = function (id) { var b = ST.best[id]; return b && b.total ? b.got / b.total : 0; };
  function status() {
    var drafts = Object.keys(TOPICS).some(function (k) { var t = ""; try { t = localStorage.getItem(WKEY + k) || ""; } catch (e) {} return nWords(t) >= (parseInt(TOPICS[k].target, 10) || 80); });
    return {
      start: CANDO.length ? ST.cando.before.filter(Boolean).length === CANDO.length : !!ST.seen.start,
      words: !!ST.seen.words, cards: ST.known.length >= 0.8 * W.length, grammar: !!ST.seen.grammar,
      match: ST.matchSets >= 3, listen: pct("listen") >= 0.8 && !!ST.best.dict, spell: pct("spell") >= 0.8 && pct("cloze") >= 0.75,
      practice: pct("practice") >= 0.8, arrange: pct("arrange") === 1,
      reading: READS.every(function (r) { return pct(r.id) >= 0.8; }), mock: !!ST.best.mock, writing: drafts
    };
  }
  function marks() { var s = status(); tabs.forEach(function (t) { t.classList.toggle("done", !!s[t.dataset.tab]); }); if (window.__sgPath) window.__sgPath(s); }
  onSave.push(marks);

  /* speak buttons anywhere */
  document.addEventListener("click", function (e) {
    var s = e.target.closest("[data-say]"); if (s) { say(s.dataset.say, s.hasAttribute("data-slow")); return; }
    var r = e.target.closest("[data-say-id]"); if (r) say(READ_TEXT[r.dataset.sayId]);
  });

  /* can-do self-check (before: start tab; after: report) */
  var LEVELS = ["Chưa · Not yet", "Cần trợ giúp · With help", "Tự tin · Confidently"];
  function candoBox(phase) {
    var el = document.createElement("div"); el.className = "cando";
    el.innerHTML = CANDO.map(function (c, i) {
      return '<div class="cd-row"><div class="cd-txt"><span class="vi">' + esc(c.vi) + '</span><br><span class="en">' + esc(c.en) + '</span></div><div class="cd-btns" role="radiogroup">' +
        LEVELS.map(function (l, k) { return '<button type="button" class="chip" role="radio" data-i="' + i + '" data-v="' + (k + 1) + '" aria-checked="' + (ST.cando[phase][i] === k + 1) + '" aria-pressed="' + (ST.cando[phase][i] === k + 1) + '">' + l + "</button>"; }).join("") + "</div></div>";
    }).join("");
    el.addEventListener("click", function (e) {
      var b = e.target.closest("[data-v]"); if (!b) return;
      var i = +b.dataset.i; ST.cando[phase][i] = +b.dataset.v; saveST();
      [].forEach.call(el.querySelectorAll('[data-i="' + i + '"]'), function (x) { var on = x === b; x.setAttribute("aria-pressed", on); x.setAttribute("aria-checked", on); });
    });
    return el;
  }

  /* ───────── start tab: study path + can-do (before) ───────── */
  (function () {
    var PATH = [["Học · Learn", [["words", 5], ["cards", 10], ["grammar", 15]]],
                ["Luyện · Practise", [["match", 5], ["listen", 15], ["spell", 15], ["practice", 15], ["arrange", 5], ["reading", 20]]],
                ["Kiểm tra · Test yourself", [["mock", SG.mockMinutes || 40]]],
                ["Viết · Write", [["writing", 25]]]];
    var total = 0; PATH.forEach(function (p) { p[1].forEach(function (x) { total += x[1]; }); });
    var card = document.createElement("div"); card.className = "ls-card";
    card.innerHTML = '<div class="ls-card-head"><h2>Lộ trình ôn tập · Your study path</h2><span class="ls-right" id="path-sum"></span></div><div class="ls-card-body">' +
      '<p class="ls-instr">Khoảng ' + Math.round(total / 60 * 2) / 2 + " giờ. Nên chia làm 3 buổi: (1) Học, (2) Luyện, (3) Thi thử và Viết. Dấu ✓ cho biết bạn đã hoàn thành phần nào. · About " + Math.round(total / 60 * 2) / 2 + " hours. Split it into three sittings: (1) Learn, (2) Practise, (3) Mock exam and Write. A ✓ shows what you have finished.</p>" +
      '<div class="scroll"><table class="t path"><tr><th>Giai đoạn · Phase</th><th>Hoạt động · Activity</th><th>Phút · Min</th><th>Xong · Done</th></tr>' +
      PATH.map(function (p) { return p[1].map(function (x, i) {
        return "<tr>" + (i === 0 ? '<td rowspan="' + p[1].length + '"><strong>' + p[0] + "</strong></td>" : "") + '<td><button type="button" class="linkbtn" data-go="' + x[0] + '">' + esc(tabLabel[x[0]] || x[0]) + "</button></td><td>" + x[1] + '</td><td class="pdone" data-p="' + x[0] + '"></td></tr>';
      }).join(""); }).join("") + "</table></div>" +
      (CANDO.length ? '<h3>Trước khi bắt đầu: bạn tự tin đến đâu? · Before you start: how confident are you?</h3><p class="hint">Bạn sẽ chọn lại trong tab Báo cáo. · You will rate these again in the Report tab.</p><div id="cando-before"></div>' : "") +
      "</div>";
    $("tab-start").appendChild(card);
    if (CANDO.length) $("cando-before").appendChild(candoBox("before"));
    card.addEventListener("click", function (e) { var b = e.target.closest("[data-go]"); if (b) { switchTab(b.dataset.go); window.scrollTo({ top: 0, behavior: "smooth" }); } });
    window.__sgPath = function (s) {
      var n = 0, all = 0;
      [].forEach.call(card.querySelectorAll(".pdone"), function (td) { all++; if (s[td.dataset.p]) { n++; td.textContent = "✓"; } else td.textContent = ""; });
      $("path-sum").textContent = n + " / " + all + " xong · done";
    };
  })();

  /* ───────── word list ───────── */
  var wordsCat = catChips($("words-cats"), true, renderWords);
  function renderWords() {
    var list = inCat(wordsCat());
    $("words-count").textContent = list.length + " từ";
    $("words-table").tBodies[0].innerHTML = list.map(function (w) {
      return '<tr class="vrow"><td><span class="vi-cell"><button type="button" class="say" data-say="' + esc(w.say) + '" aria-label="Nghe">🔊</button>' + esc(w.vi) + '</span></td><td class="meaning">' + esc(w.en) + "</td></tr>";
    }).join("");
  }
  $("words-cloak").onchange = function () { $("tab-words").classList.toggle("cloak", this.checked); };
  $("words-table").addEventListener("click", function (e) { var m = e.target.closest(".meaning"); if (m) m.classList.toggle("shown"); });
  renderWords();

  /* ───────── flashcards: know it / not yet; missed cards come back; known cards come back after a day; three modes ───────── */
  (function () {
    var MODES = [["vi", "Việt → Anh · Vietnamese first"], ["en", "Anh → Việt · English first"], ["audio", "🔊 Nghe → nghĩa · Listen first"]];
    var mode = 0, queue = [], cur = null, flipped = false, cat = "all", DAY = 864e5;
    var face = $("fc"), yes = $("fc-yes"), no = $("fc-no");
    var deck = function () { return inCat(cat); };
    var isKnown = function (w) { return ST.known.indexOf(w.vi) > -1; };
    var isDue = function (w) { return isKnown(w) && Date.now() - (ST.knownAt[w.vi] || 0) > DAY; };
    catChips($("fc-cats"), true, function (c) { cat = c; build(false); });
    function build(all) {
      var d = deck(), q = shuffle(d.filter(function (w) { return all || !isKnown(w) || isDue(w); }));
      queue = q.length ? q : shuffle(d); next();
    }
    function next() { flipped = false; cur = queue.length ? queue[0] : null; yes.disabled = no.disabled = true; draw(); }
    function draw() {
      var d = deck(), known = d.filter(isKnown).length, due = d.filter(isDue).length;
      $("fc-info").textContent = "Đã thuộc " + known + "/" + d.length + (due ? " · " + due + " thẻ cần ôn lại · due for review" : "") + " — còn " + queue.length + " thẻ trong lượt này · " + queue.length + " left this round";
      $("fc-count-head").textContent = known + " / " + d.length + " thẻ đã thuộc";
      $("fc-dir").textContent = "⇄ " + MODES[mode][1];
      face.classList.toggle("flipped", flipped);
      if (cur === null) { face.innerHTML = '<div class="fc-done">🎉 Xong lượt này! · Round complete</div>'; face.removeAttribute("aria-label"); return; }
