      if (!list.length) return;
      var meaning = {}; list.forEach(function (g) { meaning[g[0].toLowerCase()] = g[1]; });
      var re = new RegExp("(" + list.map(function (g) { return g[0].replace(/[.*+?^${}()|[\]\\]/g, "\\$&"); }).join("|") + ")", "giu");
