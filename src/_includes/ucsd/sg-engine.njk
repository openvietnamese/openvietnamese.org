        '<p class="rp-code">Điểm · Score: <strong>' + got + " / " + total + " (" + pc + "%)</strong> · Thời gian · Time: " + Math.floor(used / 60) + " phút · min</p>" +
        '<div class="scroll"><table class="t"><tr><th>Phần · Part</th><th>Điểm · Points</th></tr>' + partRows.map(function (r) { return "<tr><td>" + esc(r.title) + "</td><td>" + r.got + " / " + r.total + "</td></tr>"; }).join("") +
        "<tr><td>Phần E · Viết · Writing</td><td>" + nWords(mw) + " từ · words — tự chấm bằng bảng tiêu chí trong tab 📝 Viết · self-assess with the rubric in the 📝 Writing tab</td></tr></table></div>" +
        '<h3>Xem lại · Review</h3><p class="hint">Câu sai có đánh dấu đỏ ở trên. Câu sai được thêm vào “Ôn lỗi sai” trong tab Luyện ngữ pháp. · Wrong answers are marked in red above and added to “Review my mistakes” in the Grammar practice tab.</p>' +
        '<div class="scroll"><table class="t"><tr><th>#</th><th></th><th>Bạn trả lời · Your answer</th><th>Đáp án · Answer</th></tr>' + review + "</table></div>" +
        '<div class="row" style="margin-top:12px"><button type="button" class="btn primary" id="mock-again">↺ Thi thử lần nữa · Another mock exam</button></div>';
      box.prepend(res);
      $("mock-again").onclick = intro;
      res.scrollIntoView({ behavior: "smooth", block: "start" });
    }
    box.addEventListener("click", onClick);
    intro();
  })();

  /* accent keypads (after every card that has a .pal-slot has been built) */
  [].forEach.call(document.querySelectorAll(".pal-slot"), function (s) { if (!s.firstChild) s.appendChild(palette(s.closest(".ls-card-body") || s.parentNode)); });

  /* ───────── report ───────── */
  (function () {
    var saTotal = 0; READS.forEach(function (r) { saTotal += (r.sa || []).length; });
    var SECTIONS = [["practice", "Luyện ngữ pháp · Grammar practice", PRACTICE.length]]
      .concat(CHALLENGE.length ? [["challenge", "Thử thách · Challenge", CHALLENGE.length]] : [])
      .concat([["listen", "Nghe từ · Listening: words (best round)", 10], ["dict", "Chính tả nghe · Dictation (best round)", 6]])
      .concat(READS.map(function (r, i) { return ["lp-" + r.id, "Nghe hiểu đoạn " + (i + 1) + " · Listening: passage " + (i + 1), r.q.length]; }))
      .concat([["spell", "Viết từ · Spelling (best round)", 10], ["cloze", "Điền từ · Fill in the blank (best set)", 8], ["arrange", "Sắp xếp từ · Word arrangement", ARRANGE.length]])
      .concat(READS.map(function (r, i) { return [r.id, "Đọc hiểu " + (i + 1) + " · Reading " + (i + 1), r.q.length]; }));
    function rows() {
      var out = SECTIONS.map(function (r) { var b = ST.best[r[0]]; return { label: r[1], got: b ? b.got : 0, total: b ? b.total : r[2] }; });
      if (saTotal) out.push({ label: "Trả lời câu đầy đủ · Short answers", got: Object.keys(ST.sa).length, total: saTotal });
      return out;
    }
    function totals() { var g = 0, t = 0; rows().forEach(function (r) { g += Math.min(r.got, r.total); t += r.total; }); return { got: g, total: t, pct: t ? Math.round(100 * g / t) : 0 }; }
    function draft(k) { try { return localStorage.getItem(WKEY + k) || ""; } catch (e) { return ""; } }
    function dur(sec) { var m = Math.round(sec / 60); return m < 60 ? m + " phút · min" : Math.floor(m / 60) + " giờ " + (m % 60) + " phút · " + Math.floor(m / 60) + " h " + (m % 60) + " min"; }
    function when(ts) { return new Date(ts).toLocaleString("vi-VN", { dateStyle: "short", timeStyle: "short" }); }
    function code() {
      var str = ST.name.trim().toLowerCase() + "|" + SG.code + "|" + totals().got + "|" + ST.known.length + "|" + (ST.mock ? ST.mock.got : 0), x = 2166136261;
      for (var i = 0; i < str.length; i++) { x ^= str.charCodeAt(i); x = Math.imul(x, 16777619) >>> 0; }
      return "U" + SG.code + "-GK-" + totals().pct + "-" + x.toString(36).toUpperCase().slice(-5);
    }
    var WR = Object.keys(TOPICS).map(function (k) { return [k, TOPICS[k].label]; });
    var lvl = function (n) { return n ? LEVELS[n - 1] : "—"; };
    function parts() {   // shared by the on-page report and the downloaded file
      var tt = totals(), m = ST.mock;
      return {
        scoreRows: rows().map(function (r) { return "<tr><td>" + esc(r.label) + "</td><td>" + Math.min(r.got, r.total) + " / " + r.total + "</td><td>" + (r.total ? Math.round(100 * Math.min(r.got, r.total) / r.total) : 0) + "%</td></tr>"; }).join("")
          + '<tr><td><strong>Tổng · Total</strong></td><td><strong>' + tt.got + " / " + tt.total + "</strong></td><td><strong>" + tt.pct + "%</strong></td></tr>",
        mockRows: m ? "<tr><td>Lần gần nhất · Last attempt</td><td><strong>" + m.got + " / " + m.total + " (" + m.pct + "%)</strong> · " + when(m.at) + " · " + Math.round(m.secs / 60) + " phút · min</td></tr>" +
          m.parts.map(function (p) { return "<tr><td>" + esc(p.title) + "</td><td>" + p.got + " / " + p.total + "</td></tr>"; }).join("") +
          (ST.best.mock ? "<tr><td>Tốt nhất · Best</td><td>" + ST.best.mock.got + " / " + ST.best.mock.total + "</td></tr>" : "") : "<tr><td colspan=\"2\">Chưa thi thử · No mock exam yet</td></tr>",
        practiceRows: "<tr><td>Thẻ từ · Flashcards known</td><td>" + ST.known.length + " / " + W.length + " từ</td></tr><tr><td>Nối từ · Matching sets completed</td><td>" + ST.matchSets + "</td></tr>" +
          "<tr><td>Còn cần ôn · Still to review</td><td>" + ST.missQ.length + " câu hỏi · questions, " + ST.missW.length + " từ · words</td></tr>",
        timeRows: "<tr><td>Bắt đầu · Started</td><td>" + when(ST.start) + "</td></tr><tr><td>Thời gian làm bài · Time on task</td><td><strong>" + dur(ST.active) + "</strong></td></tr>",
        cando: CANDO.length ? "<tr><th>Tôi có thể… · I can…</th><th>Lúc đầu · Start</th><th>Bây giờ · Now</th></tr>" + CANDO.map(function (c, i) { return "<tr><td>" + esc(c.vi) + '<br><span class="en">' + esc(c.en) + "</span></td><td>" + lvl(ST.cando.before[i]) + "</td><td>" + lvl(ST.cando.after[i]) + "</td></tr>"; }).join("") : "",
        rubric: Object.keys(TOPICS).filter(function (k) { return (ST.rubric[k] || []).some(Boolean); }).map(function (k) {
          var cur = ST.rubric[k];
          return "<h4>" + esc(TOPICS[k].label) + "</h4><table>" + RUBRIC.map(function (c, i) { return "<tr><td>" + esc(c[0]) + "</td><td>" + (cur[i] ? cur[i] + " · " + esc(c[1][cur[i] - 1]) : "—") + "</td></tr>"; }).join("") + "</table>";
        }).join(""),
        writing: WR.map(function (w) { var t = draft(w[0]); return t.trim() ? "<h4>" + esc(w[1]) + " · " + nWords(t) + ' từ</h4><div class="PFX-text">' + esc(t) + "</div>" : ""; }).join("") +
          (m && m.writing && m.writing.trim() ? "<h4>Thi thử · Mock exam — " + esc(TOPICS[m.topic] ? TOPICS[m.topic].label : "") + " · " + nWords(m.writing) + ' từ</h4><div class="PFX-text">' + esc(m.writing) + "</div>" : "")
      };
    }
    function draw() {
      var tt = totals(), P = parts(), box = $("report-box");
      box.innerHTML =
        '<div class="rp-head"><div><div class="rp-ch">' + esc(SG.course) + ' · Ôn thi giữa kỳ — Midterm study guide</div><div class="rp-date">' + new Date().toLocaleDateString("vi-VN") + '</div></div>' +
        '<input class="rp-name" id="rp-name" type="text" data-allow-paste autocomplete="name" placeholder="Họ và tên · Your name" aria-label="Họ và tên · Your name"></div>' +
        '<div class="rp-stats"><div class="rp-stat"><span>Điểm luyện tập · Practice score</span><b>' + tt.pct + '%</b></div>' +
        '<div class="rp-stat"><span>Thi thử · Mock exam</span><b>' + (ST.mock ? ST.mock.pct + "%" : "—") + "</b></div>" +
        '<div class="rp-stat"><span>Thẻ đã nhớ · Cards known</span><b>' + ST.known.length + " / " + W.length + '</b></div>' +
        '<div class="rp-stat"><span>Thời gian · Time on task</span><b>' + dur(ST.active).split(" · ")[0] + '</b></div></div>' +
        '<p class="rp-code">Mã hoàn thành · Completion code: <strong id="rp-code">' + code() + '</strong></p>' +
        (CANDO.length ? '<h3>Bây giờ bạn tự tin đến đâu? · Now: how confident are you?</h3><div id="cando-after"></div>' : "") +
        '<h3>Thời gian · Time</h3><div class="scroll"><table class="t">' + P.timeRows + '</table></div>' +
        '<h3>Thi thử · Mock exam</h3><div class="scroll"><table class="t">' + P.mockRows + '</table></div>' +
        '<h3>Kết quả từng phần · Results by section</h3><div class="scroll"><table class="t"><tr><th>Phần · Section</th><th>Điểm · Points</th><th>%</th></tr>' + P.scoreRows + '</table></div>' +
        '<p class="hint" style="margin-top:8px">Điểm tốt nhất của mỗi phần được giữ lại. · The best score for each section is kept.</p>' +
        '<h3>Hoạt động khác · Other activities</h3><div class="scroll"><table class="t">' + P.practiceRows + '</table></div>' +
        (P.cando ? '<h3>Tự đánh giá · Can-do self-check</h3><div class="scroll"><table class="t">' + P.cando + "</table></div>" : "") +
        (P.rubric ? '<h3>Tự chấm bài viết · Writing self-assessment</h3><div class="scroll rp-rub">' + P.rubric.replace(/<table>/g, '<table class="t">') + "</div>" : "") +
        '<h3>Bài viết · Writing</h3>' + (P.writing.replace(/PFX/g, "rp") || '<p class="hint">Chưa có bài viết. Viết trong tab 📝 Viết rồi quay lại đây. · No draft yet: write in the 📝 tab, then come back.</p>') +
        '<div class="row" style="margin-top:20px"><button type="button" class="btn primary" id="rp-dl">⬇ Tải báo cáo · Download report (.html)</button><button type="button" class="btn" id="rp-reset">Làm lại từ đầu · Reset</button></div>' +
        '<div class="fb" id="rp-fb" aria-live="polite"></div>' +
        '<p class="hint">Mọi thứ chỉ lưu trên thiết bị này. Tải báo cáo để nộp cho giáo viên (ví dụ trên Canvas). · Everything is stored only on this device. Download the report to hand in (for example on Canvas).</p>';
      if (CANDO.length) $("cando-after").appendChild(candoBox("after"));
      var nm = $("rp-name"); nm.value = ST.name;
      nm.addEventListener("input", function () { ST.name = nm.value; saveST(); $("rp-code").textContent = code(); });
      $("rp-dl").onclick = function () {
        if (!ST.name.trim()) { $("rp-fb").className = "fb no"; $("rp-fb").textContent = "✍️ Nhập họ và tên trước khi tải · Type your name first."; nm.focus(); return; }
        download(); $("rp-fb").className = "fb ok"; $("rp-fb").textContent = "✅ Đã tải · Downloaded. Upload this .html file.";
      };
      $("rp-reset").onclick = function () {
        if (!confirm("Xóa toàn bộ tiến độ và bài viết? · Delete all progress and writing drafts?")) return;
        try { localStorage.removeItem(SKEY); Object.keys(TOPICS).forEach(function (k) { localStorage.removeItem(WKEY + k); }); } catch (e) {}
        location.reload();
      };
    }
    function download() {
      var tt = totals(), P = parts(), d = new Date();
      var html = '<!doctype html>\n<!-- Content by Hoan Nguyen (UC San Diego) · Design by HUY · Supported by the Open Vietnamese Initiative. Content © Hoan Nguyen. -->\n<html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">' +
        "<title>Báo cáo " + esc(SG.course) + " giữa kỳ — " + esc(ST.name) + "</title><style>" +
        "body{font-family:Roboto,Arial,sans-serif;max-width:820px;margin:24px auto;padding:0 16px;color:#1F2A37;line-height:1.5}" +
        "h1{font-size:1.4rem;color:#182B49;margin-bottom:4px}h2{font-size:1rem;color:#182B49;margin:24px 0 8px;text-transform:uppercase;letter-spacing:.05em}h4{margin:14px 0 6px;color:#182B49}" +
        "table{width:100%;border-collapse:collapse}td,th{padding:6px 8px;border-bottom:1px solid #D5E0E8;text-align:left;vertical-align:top}th{background:#E6EFF5}" +
        ".code{font-size:1.1rem;background:#E6EFF5;border-left:4px solid #00629B;padding:10px 14px;border-radius:6px}.meta,.en{color:#5B6770}" +
        ".dl-text{white-space:pre-wrap;background:#F2F6F9;border-radius:8px;padding:12px;line-height:1.6}" +
        "</style></head><body><h1>" + esc(SG.course) + " · Ôn thi giữa kỳ (Midterm study guide)</h1>" +
        '<p class="meta">Học viên · Learner: <strong>' + esc(ST.name) + "</strong> · " + d.toLocaleString("vi-VN") + "</p>" +
        '<p class="code">Mã hoàn thành · Completion code: <strong>' + code() + "</strong> · Điểm luyện tập · Practice score: <strong>" + tt.pct + "%</strong>" + (ST.mock ? " · Thi thử · Mock: <strong>" + ST.mock.pct + "%</strong>" : "") + "</p>" +
        "<h2>Thời gian · Time</h2><table>" + P.timeRows + "</table>" +
        '<p class="meta">Time on task counts only while this page was open and in use (idle over 2 minutes is not counted).</p>' +
        "<h2>Thi thử · Mock exam</h2><table>" + P.mockRows + "</table>" +
        "<h2>Kết quả từng phần · Results by section</h2><table><tr><th>Phần</th><th>Điểm</th><th>%</th></tr>" + P.scoreRows + "</table>" +
        "<h2>Hoạt động khác · Other activities</h2><table>" + P.practiceRows + "</table>" +
        (P.cando ? "<h2>Tự đánh giá · Can-do self-check</h2><table>" + P.cando + "</table>" : "") +
        (P.rubric ? "<h2>Tự chấm bài viết · Writing self-assessment</h2>" + P.rubric : "") +
        "<h2>Bài viết · Writing</h2>" + (P.writing.replace(/PFX/g, "dl") || "<p>—</p>") + "</body></html>";
      var slug = ST.name.normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/đ/gi, "d").replace(/[^a-z0-9]+/gi, "-").replace(/^-|-$/g, "").toLowerCase() || "hoc-vien";
      var a = document.createElement("a"); a.href = URL.createObjectURL(new Blob([html], { type: "text/html" }));
      a.download = "ucsd" + SG.code + "-midterm-guide-" + slug + "-" + d.toISOString().slice(0, 10) + ".html";
      document.body.appendChild(a); a.click(); a.remove();
    }
    tabs.forEach(function (t) { if (t.dataset.tab === "report") t.addEventListener("click", draw); });
    draw();
  })();

  marks();
})();
</script>
