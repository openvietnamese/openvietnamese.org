      var r = el.getBoundingClientRect(), bw = box.offsetWidth, bh = box.offsetHeight;
      var x = Math.max(8, Math.min(window.innerWidth - bw - 8, r.left + r.width / 2 - bw / 2));
      var y = r.top - bh - 8 < 8 ? r.bottom + 8 : r.top - bh - 8;
